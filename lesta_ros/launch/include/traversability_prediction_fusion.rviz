Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RELLIS-3D Camera1
        - /RELLIS-3D LiDAR1
        - /1_Geometry_Step (GridMap)1
        - /2_Visual_Cost (GridMap)1
        - /3_Fused_Probability (GridMap)1
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
    
    # 真实场景参考视图
    - Class: rviz/Image
      Enabled: true
      Image Topic: /pylon_camera_node/image_raw
      Name: RELLIS-3D Camera
      Queue Size: 2
    
    # 物理结构参考视图
    - Alpha: 1
      Class: rviz/PointCloud2
      Color Transformer: Intensity
      Enabled: true
      Name: RELLIS-3D LiDAR
      Position Transformer: XYZ
      Size (Pixels): 2
      Style: Points
      Topic: /os1_cloud_node/points
    
    # [核心对比 1] 纯几何的物理底线层
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Class: grid_map_rviz_plugin/GridMap
      Color Layer: feature/step
      Color Map: Rainbow
      Enabled: false  # 默认关闭，方便您在演示时手动打勾切换对比
      History Length: 1
      Max: 0.3
      Min: 0.0
      Name: 1_Geometry_Step (GridMap)
      Topic: /traversability_map
      Use Color Map: true
      
    # [核心对比 2] 纯视觉的语义先验层
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Class: grid_map_rviz_plugin/GridMap
      Color Layer: visual_cost
      Color Map: Viridis
      Enabled: false