<launch>
  <param name="/use_sim_time" value="true" />

  <arg name="mlp_model_path" default="$(find lesta)/weights/mlp_classifier_fusion_traced.pt" />
  <arg name="vision_model_path" default="$(find lesta)/weights/mobilenetv3_cost_epoch_30.pth" />

  <node pkg="lesta" type="visual_cost_node.py" name="visual_cost_mobilenet_node" output="screen">
      <param name="model_path" value="$(arg vision_model_path)" />
      <param name="camera_topic" value="/pylon_camera_node/image_raw" />
  </node>

  <node pkg="lesta" type="trav_prediction_node" name="lesta_trav_prediction" output="screen" >
    <rosparam command="load" subst_value="true" file="$(find lesta)/config/trav_prediction_node.yaml" />
    <rosparam command="load" subst_value="true" file="$(find lesta)/config/include/feature_extraction_params.yaml" />
    
    <remap from="/velodyne/points" to="/os1_cloud_node/points" />
    <remap from="/lesta/visual_cost_map" to="/visual_cost_map" />
  </node>

  <node pkg="grid_map_visualization" type="grid_map_visualization" name="trav_feature_visualization" output="log">
    <rosparam command="load" file="$(find lesta)/config/include/feature_visualization.yaml" />
  </node>

  <node pkg="rviz" type="rviz" name="rviz_traversability_prediction" output="log" 
        args="-d $(find lesta)/launch/include/traversability_prediction_fusion.rviz" />
  
</launch>